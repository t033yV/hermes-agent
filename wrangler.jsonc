{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "containers": [
    {
      "class_name": "HermesContainer",
      "scheduling_policy": "durable_object",
      "authorized_keys": [
        {
          "name": "mick",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMZw9Gubsz0SZJa0nhXUZhIOy3jBJ8Gjm5chlZXwncH3 mick@mickvercettis-imac.tail820758.ts.net"
        }
      ],
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "HermesContainer",
        "name": "HERMES_CONTAINER"
      }
    ]
  },
  "exports": {
    "HermesContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
