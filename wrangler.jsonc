{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "containers": [
    {
      "class_name": "HermesContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "HermesContainer",
        "name": "HERMES_CONTAINER"
      }
    ]
  },
  "exports": {
    "HermesContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
